# --- Option A: Claude API ---
# LLM_PROVIDER=anthropic
# LLM_API_KEY=your-key-here
# LLM_MODEL=claude-haiku-5-5

# --- Option B: local model with Ollama (no data leaves your machine) ---
LLM_PROVIDER=openai
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=ollama
LLM_TIMEOUT=300

# --- Option C: OpenAI ---
# LLM_PROVIDER=openai
# LLM_API_KEY=your-key-here
# LLM_MODEL=<model name>

# --- OCR ---
OCR_MODE=single
OCR_MAX_SIDE=2000

VLM_MODEL=qwen2.5vl-invoice
VLM_MAX_SIDE=1600
VLM_TIMEOUT=300